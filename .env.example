# Sentinel-Edge environment (copy to .env; .env is git-ignored).
# Phase 1: sentinelctl. Every value can also be passed as a CLI flag.

# Interface the XDP program attaches to (the PoP's uplink NIC).
XS_IFACE=eth0

# Compiled XDP object (built by `make bpf`).
SENTINEL_BPF_OBJ=build/ebpf/xdp_main.o

# bpffs directory for pinned maps and links.
SENTINEL_PIN_DIR=/sys/fs/bpf/sentinel

# PoP unicast addresses: traffic to them bypasses filtering (BGP, SSH, NATS).
XS_POP_IP4=10.10.1.1
XS_POP_IP6=2001:db8:100::1

# PoP agent (phase 4): config file path; secrets are files referenced from it.
SENTINEL_AGENT_CONFIG=configs/agent.local.toml
# sentinelctl warns when this heartbeat is fresh (an agent owns the maps).
SENTINEL_HEARTBEAT_FILE=/run/sentinel/heartbeat

# Control-plane API (phase 5). Placeholders only: real values never in git.
SENTINEL_API_CONFIG=configs/api.local.toml
# Role sentinel_api (subject to Row Level Security):
SENTINEL_DATABASE_URL=postgres://sentinel_api:CHANGE_ME@localhost/sentinel
# Owner role, used only by `sentinel-api migrate`:
SENTINEL_DATABASE_OWNER_URL=postgres://sentinel_owner:CHANGE_ME@localhost/sentinel
# base64 of 32 random bytes (head -c 32 /dev/urandom | base64): encrypts TOTP secrets.
SENTINEL_DATA_KEY=
# Only for `sentinel-api create-admin`:
SENTINEL_ADMIN_PASSWORD=
