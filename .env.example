# Sentinel-Edge environment (copy to .env; .env is git-ignored).
# Phase 1: sentinelctl. Every value can also be passed as a CLI flag.

# Interface the XDP program attaches to (the PoP's uplink NIC).
XS_IFACE=eth0

# Compiled XDP object (built by `make bpf`).
SENTINEL_BPF_OBJ=build/ebpf/xdp_main.o

# bpffs directory for pinned maps and links.
SENTINEL_PIN_DIR=/sys/fs/bpf/sentinel

# PoP unicast addresses: traffic to them bypasses filtering (BGP, SSH, NATS).
XS_POP_IP4=10.10.1.1
XS_POP_IP6=2001:db8:100::1
