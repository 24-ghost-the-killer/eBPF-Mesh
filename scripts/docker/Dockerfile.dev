# Reproducible Linux build/test toolchain for eBPF Mesh.
#
# Used by `make docker-test` (and handy on macOS). The container does NOT
# emulate a NIC; it compiles the BPF object and the Rust workspace, runs the
# verifier against the Docker host's kernel, runs BPF_PROG_TEST_RUN tests and
# the veth/netns integration test. BPF loading needs `docker run --privileged`.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        clang llvm \
        libbpf-dev libelf-dev zlib1g-dev pkg-config linux-libc-dev \
        make gcc libc6-dev \
        iproute2 iputils-ping procps python3 \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
# Keep in sync with rust-toolchain.toml.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain 1.94.1 --component rustfmt,clippy \
    && rustc --version

# bpffs is mounted by tests/integration/veth.sh when missing.
WORKDIR /src
