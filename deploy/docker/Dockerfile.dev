# SPDX-License-Identifier: MIT OR Apache-2.0
# Development / test image. Builds and runs every test target, including the
# root-only BPF and veth tests (run the container with --privileged).
#
#   make docker-test     # build image, run all suites
#   make docker-shell    # interactive shell with the repo at /src
FROM debian:trixie

ARG RUST_VERSION=1.94.1

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang llvm curl git make pkg-config \
        libbpf-dev libelf-dev zlib1g-dev bpftool \
        iproute2 iputils-ping jq procps python3 \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain ${RUST_VERSION} --component rustfmt,clippy \
    && chmod -R a+w ${RUSTUP_HOME} ${CARGO_HOME}

WORKDIR /src
