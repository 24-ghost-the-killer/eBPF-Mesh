# SPDX-License-Identifier: MIT OR Apache-2.0
# Control-plane binaries (sentinel-api, sentinel-worker) for docker compose.
# Build context: the repository root.
FROM rust:1.94.1-slim-trixie AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        pkg-config ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p sentinel-api -p sentinel-worker \
    && cp target/release/sentinel-api target/release/sentinel-worker /usr/local/bin/

FROM debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /nonexistent sentinel
COPY --from=build /usr/local/bin/sentinel-api /usr/local/bin/sentinel-worker /usr/local/bin/
USER sentinel
