# Browser-test image: the dev image plus Node.js, pnpm and the system
# libraries Chromium needs. The browser itself is downloaded by Playwright
# into a cached volume at test time (matching the lockfile's version).
#
#   make docker-test-web    # Vitest + build + Playwright against the lab
ARG BASE=sentinel-dev
FROM ${BASE}

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY install-node.sh /tmp/install-node.sh
RUN sh /tmp/install-node.sh && rm /tmp/install-node.sh

# Chromium's shared libraries and fonts (Debian package names, as listed by
# `playwright install-deps chromium`).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
        libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 \
        libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
        fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /src
