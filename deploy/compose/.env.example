# Control plane (docker compose). Copy to state/.env via scripts/init.sh;
# secrets are generated there, never committed.
PORTAL_DOMAIN=portal.example.org      # DNS name of the portal + API (one origin)
TLS_ISSUER=ops@example.org            # ACME contact e-mail, or "internal" for a test CA
HTTPS_PORT=443
NATS_HOSTNAME=nats.mgmt.example.org   # how PoP agents reach NATS (certificate name)
NATS_PORT=4222
SENTINEL_POPS="ams1 fra1"             # PoP ids: one NATS user each
SENTINEL_WORKERS="worker-1 worker-2"
ANYCAST_PREFIX4=198.51.100.0/24       # protected IPs come from here
TUNNEL_EP4=198.51.100.1
STATUS_PAGE_ORIGIN=https://status.example.org
CONTACT_EMAIL=hello@example.org
